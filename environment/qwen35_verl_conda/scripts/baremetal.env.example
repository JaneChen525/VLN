# Copy to a private shell file, edit the paths, then: source baremetal.env
export WORK=/data/qwen35-verl-work
export WORLDMODEL=/data/src/VLN
export HANDOFF=$WORLDMODEL/environment/qwen35_verl_conda
export CONDA_ROOT=$HOME/miniconda3
export ENV_PREFIX=$WORK/conda-envs/qwen35-verl-vllm018
export VERL_SRC=$WORLDMODEL/vln/reinforcement_learning
export MODEL_DIR=$WORK/checkpoints/Qwen3.5-4B-base
export MANIFEST_DIR=$WORLDMODEL/artifacts/qwen35-conda-env
export CUDA_VISIBLE_DEVICES=0
export ALLOW_RESUME=0
